{
  "template": {
    "settings": {
      "index": {
        "lifecycle": {
          "name": "business-ilm"
        }
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "level": {
          "type": "keyword"
        },
        "msg": {
          "type": "keyword"
        },
        "messageType": {
          "type": "keyword"
        },
        "businessOperation": {
          "type": "keyword"
        },
        "origin": {
          "type": "keyword"
        },
        "destination": {
          "type": "keyword"
        },
        "correlationId": {
          "type": "keyword"
        },
        "user": {
          "type": "keyword"
        },
        "userIp": {
          "type": "ip"
        },
        "thread": {
          "type": "keyword"
        },
        "http.method": {
          "type": "keyword"
        },
        "http.action": {
          "type": "keyword"
        },
        "http.status": {
          "type": "keyword"
        }
      }
    }
  },
  "index_patterns": [
    "business-logs-*"
  ],
  "data_stream": {
    "hidden": false,
    "allow_custom_routing": false
  },
  "composed_of": [],
  "priority": 200
}
